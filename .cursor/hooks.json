{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "node .cursor/hooks/playwright-failure-bug-reporter.js",
        "matcher": "Shell"
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/guard-test-assertions.js",
        "matcher": "Write",
        "failClosed": true
      }
    ]
  }
}
